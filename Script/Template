getgenv().BVaildSelect = {
    ["No Background"] = "rbxassetid://0",
    ["Robin HeadPat"]     =  "https://raw.githubusercontent.com/oppw884-netizen/FemboyHub/refs/heads/main/UI/8557765547548454842855184654955.jpe",
    ["Robin 4thOfJuly"]   =  "https://raw.githubusercontent.com/oppw884-netizen/FemboyHub/refs/heads/main/UI/89db9644519d494fc46cfcd99285c317.jpg",
    ["Robin OnTheCouch"]  =  "https://raw.githubusercontent.com/oppw884-netizen/FemboyHub/refs/heads/main/UI/b30b6abebd16aeae4b36fcb7d0eba396.jpg",
    ["Robin PoolDay"]     =  "https://raw.githubusercontent.com/oppw884-netizen/FemboyHub/refs/heads/main/UI/cd678d206bbd5ff74274f3821007138a.jpg",
}
local firstRun = true

local SBA = SettingsTab:Dropdown({
    Title = "Select Background",
    Values = { "No Background", "Robin HeadPat", "Robin 4thOfJuly", "Robin OnTheCouch", "Robin PoolDay" },
    Value = "No Background",
    Callback = function(option)
        if firstRun then
            firstRun = false
            return
        end
        
        local bgValue = getgenv().BVaildSelect[option]
        
        if bgValue:match("^http") then
            task.spawn(function()
                local ok, fetchResult = pcall(function()
                    return AssetKit.Fetch({ [option] = bgValue })
                end)
                
                if ok and fetchResult and fetchResult[option] then
                    _G.BackgroundImage = fetchResult[option].id
                    Window:SetBackgroundImage(_G.BackgroundImage)
                    Notify("Background", "Loaded " .. option .. " successfully!", "image", 2)
                else
                    Notify("Error", "Failed to load image link.", "triangle-alert", 3)
                end
            end)
        else
            _G.BackgroundImage = bgValue
            Window:SetBackgroundImage(_G.BackgroundImage)
        end
    end
})

